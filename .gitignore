# --- Personal app data: never commit your own notes/attachments ---
# notes_data*.json covers notes_data.json itself plus the timestamped
# backups backup_notes_file()/_timestamped_backup() create next to it
# (notes_data_backup_<stamp>.json, notes_data_replaced_<stamp>.json) —
# those are just as much real user data as notes_data.json itself.
notes_data*.json
settings.json
trash.json
templates.json
attachments/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/

# --- PyInstaller build artifacts ---
build/
dist/
*.spec

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# --- QA scratch files (keep the tracked test plan, ignore working copies) ---
qa/__pycache__/
qa/*.json
