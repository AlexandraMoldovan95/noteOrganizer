# --- Personal app data: never commit your own notes/attachments ---
# notes_data*.json covers notes_data.json itself plus the timestamped
# backups backup_notes_file()/_timestamped_backup() create next to it
# (notes_data_backup_<stamp>.json, notes_data_replaced_<stamp>.json) —
# those are just as much real user data as notes_data.json itself.
notes_data*.json
settings.json
trash.json
templates.json
attachments/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/

# --- PyInstaller build artifacts ---
build/
dist/
# Auto-generated specs (from "pyinstaller script.py") are throwaway, but
# NoteOrganizer.spec is the hand-maintained build recipe this project
# actually ships with — see CLAUDE.md. Ignoring it meant build settings
# (e.g. the numpy exclusion) lived only on one machine and couldn't be
# reproduced from a fresh clone or in CI.
*.spec
!NoteOrganizer.spec

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# --- Runtime artifacts the app writes beside itself when run from source ---
# crash_log.txt is the app's own last-resort logger; the .tmp is a save
# that failed partway and is overwritten by the next successful save.
crash_log.txt
notes_data.json.tmp

# The single-instance lock: created beside the notebook on every launch
# (the repo root, when run from source) and kept while the app is open.
.notebook.lock

# --- QA scratch files (keep the tracked test plan, ignore working copies) ---
qa/__pycache__/
qa/*.json
